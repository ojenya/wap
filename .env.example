# Copy to .env and fill in values:
#   cp .env.example .env
#
# Settings are loaded by apps/api (pydantic-settings). Most keys accept either
# APP_* or the unprefixed alias shown below. docker compose reads the same
# names via ${VAR} substitution.

# --- Core ---------------------------------------------------------------
APP_DATABASE_URL=sqlite:///./agentplatform.db
# RAG / Postgres (optional):
# APP_DATABASE_URL=postgresql+psycopg://wap:wap@localhost:5432/wap
APP_DATA_DIR=./data
APP_SECRET_KEY=dev-only-change-me
APP_AUTH_REQUIRED=false
APP_BOOTSTRAP_ADMIN_KEY=dev-admin-key
# APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- GitLab OAuth (Repositories → Connect GitLab) -----------------------
GITLAB_BASE_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:5173/repositories?oauth=gitlab

# --- GitHub OAuth (Repositories → Connect GitHub) -----------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/repositories?oauth=github

# --- opencode Implementation Agent (optional) ---------------------------
OPENCODE_API_KEY=
OPENCODE_PLAN=zen
OPENCODE_MODEL=opencode/qwen3-coder

# --- Playwright Sandbox QA ----------------------------------------------
APP_PLAYWRIGHT_ENABLED=true
APP_PLAYWRIGHT_TIMEOUT_SECONDS=120

# --- Firecracker microVM environments -----------------------------------
# auto    = real FC when KVM+binary+assets available, else emulate
# emulate = CI / hosts without /dev/kvm (stub FC API + workspace jail)
# require = fail if a real Firecracker boot is impossible
# local   = force local jail backend (no Firecracker)
APP_FIRECRACKER_MODE=auto
APP_FIRECRACKER_BIN=firecracker
# Required for real microVMs on a KVM host:
# APP_FIRECRACKER_KERNEL=/path/to/vmlinux
# APP_FIRECRACKER_ROOTFS=/path/to/rootfs.ext4
